@unpublished{mohammadi_wasserstein_equivalent_metric_2026,
  title    = {Toscani--Fourier Distance on Probability Measures: Wasserstein Control, Topological Equivalence on Model Classes, and Duality},
  author   = {Mohammadi, Mehrdad},
  year     = {2026},
  url      = {https://arxiv.org/abs/2609.23163},
  status   = {under-review},
  topic    = {theory-and-methods},
  abstract = {Comparing probability measures in machine learning trades transport geometry against computational cost: Wasserstein distances encode the geometry of $\mathbb R^d$ but require solving a transport problem, while kernel discrepancies are cheap to evaluate yet depend delicately on their test class. We study the Toscani--Fourier family $\mathrm T_{s,p}$, the weighted $L^p$ norm of the difference of two characteristic functions, as a continuous Fourier-side discrepancy on $\mathbb R^d$. For $1\le p<\infty$ we show that $d/p<s<1+d/p$ is exactly the window in which $\mathrm T_{s,p}$ is finite on $\mathcal P_p(\mathbb R^d)$, both endpoints already failing for a pair of Dirac measures, and we establish the metric, embedding, and compactness structure of the resulting space, which we prove to be complete. Duality identifies $\mathrm T_{s,p}$ as an integral probability metric over a homogeneous Fourier--Lebesgue ball, with an explicit extremizer when $1<p<\infty$. We prove the global bound $\mathrm T_{s,p}\lesssim W_p^{\,s-d/p}$, whose exponent is sharp, show that no global converse of any form can hold, and recover topological equivalence with $W_p$ on bounded-support and uniform-tail classes, together with explicit reverse moduli on bounded-support classes that improve the imported energy-kernel exponent at $p=2$. There, $\mathrm T_{s,2}$ is a constant multiple of the classical energy distance, which yields an exact finite-sample identity for the mean of the empirical discrepancy; the numerical experiments are otherwise diagnostic.
}
}

@unpublished{mohammadi_simpson_dating_errors_2026,
  title    = {SILK: Shift-Invariant Landmark Kernels for Dynamic Risk Prediction with an Unknown Time Origin},
  author   = {Mohammadi, Mehrdad and Simpson, Douglas G.},
  year     = {2026},
  status   = {under-review},
  topic    = {theory-and-methods},
  abstract = {Dynamic prediction in longitudinal studies often conditions on age or disease duration measured from an estimated rather than observed origin, leading to systematic timing errors. We propose Shift-Invariant Landmark Kernels (SILK), a modular calibration approach that uses biomarker histories to correct landmark age before modeling residual event risk. SILK aligns individual biomarker trajectories with age-indexed population templates through a weighted maximum mean discrepancy criterion, allowing robust prediction despite missing information about origin times. We establish theoretical properties including identifiability, consistency, and valid large-sample inference and demonstrate through simulations that SILK recovers much of the performance lost to timing error without incurring appreciable loss of efficiency when age is correctly measured. Application to the Multicenter AIDS Cohort Study shows substantial improvement over landmarking on the recorded clock at every disease-duration landmark, with the largest gains at intermediate durations. These results indicate that SILK is most valuable when the origin-time error substantially affects the prediction, and it neither helps nor hurts when the origin error is small.
}
}

@misc{mohammadi2026vectorvalued_drl_policy_evaluation,
  title         = {Vector-Valued Distributional Reinforcement Learning Policy Evaluation: A Hilbert Space Embedding Approach},
  shorttitle    = {Off-policy Distributional Reinforcement Learning},
  author        = {Mohammadi, Mehrdad and Zheng, Qi and Zhu, Ruoqing},
  year          = {2026},
  eprint        = {2601.18952},
  archivePrefix = {arXiv},
  url           = {https://arxiv.org/abs/2601.18952},
  status        = {under-review},
  topic         = {theory-and-methods},
  abstract      = {We propose an (offline) multi-dimensional distributional reinforcement learning framework (KE-DRL) that leverages Hilbert space mappings to estimate the kernel mean embedding of the multi-dimensional value distribution under a proposed target policy. In our setting the state-action are multi-dimensional and continuous. By mapping probability measures into a reproducing kernel Hilbert space via kernel mean embeddings, our method replaces Wasserstein metrics with a integral probability metric. This enables efficient estimation in multi-dimensional state--action spaces and reward settings, where direct computation of Wasserstein distances is computationally challenging. Theoretically, we establish contraction properties of the distributional Bellman operator under our proposed metric involving the Mat\'ern family of kernels and provide uniform convergence guarantees. Simulations and empirical results demonstrate robust off-policy evaluation and recovery of kernel mean embedding under mild assumptions, namely, Lipschitz continuity and boundedness for the kernels, highlighting the potential of our embedding-based approaches in complex, real-world decision-making scenarios and risk evaluations.}
}

